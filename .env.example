# =============================================================================
# CHAKRA AML Investigation System — Environment Configuration
# =============================================================================

# Server Settings
ENVIRONMENT=production
DEBUG=false
API_PORT=8000
FRONTEND_PORT=3000
SECRET_KEY=change_me_to_a_secure_random_key_in_production_compliance_2026
LOG_LEVEL=INFO

# Database Settings
# PostgreSQL (Production):
DATABASE_URL=postgresql+asyncpg://aml_user:aml_password@localhost:5432/aml_db
# SQLite (Local Dev fallback):
# DATABASE_URL=sqlite+aiosqlite:///./aml.db

POSTGRES_USER=aml_user
POSTGRES_PASSWORD=aml_password
POSTGRES_DB=aml_db
POSTGRES_PORT=5432

# 4-Pillar Risk Scoring Weights (Must sum to 1.0)
RISK_WEIGHT_ML=0.40
RISK_WEIGHT_ANOMALY=0.20
RISK_WEIGHT_RULES=0.20
RISK_WEIGHT_NETWORK=0.20

# Regulatory Compliance Framework
STATUTORY_COMPLIANCE_PMLA=true
STATUTORY_COMPLIANCE_RBI_2026=true
JURISDICTION=FIU-IND, New Delhi, India
REPORTING_ENTITY_CODE=IN_BANK_042
