# =============================================================================
# AML Investigation System — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Application
APP_NAME="AML Investigation System"
APP_VERSION="1.0.0"
DEBUG=false
RANDOM_SEED=42
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
# Use postgresql+asyncpg for async, or sqlite+aiosqlite for local dev
DATABASE_URL=postgresql+asyncpg://aml_user:your_password@localhost:5432/aml_db
# DATABASE_URL=sqlite+aiosqlite:///./aml_local.db

# PostgreSQL (used by docker-compose)
POSTGRES_USER=aml_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=aml_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=change_this_to_a_strong_random_secret_key
API_KEY_HEADER=X-API-Key

# ML / Model Paths
MODEL_DIR=./models/v1
FRAUD_CLASSIFIER_PATH=./models/v1/fraud_classifier.pkl
ANOMALY_DETECTOR_PATH=./models/v1/anomaly_detector.pkl
FEATURE_SCALER_PATH=./models/v1/feature_scaler.pkl

# Data Paths
RAW_DATA_DIR=./ml/data/raw
PROCESSED_DATA_DIR=./ml/data/processed
SYNTHETIC_DATA_DIR=./ml/data/synthetic

# Risk Engine Weights (must sum to 1.0)
RISK_WEIGHT_ML=0.40
RISK_WEIGHT_ANOMALY=0.20
RISK_WEIGHT_RULES=0.20
RISK_WEIGHT_NETWORK=0.20

# Risk Thresholds
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
# 80+ = CRITICAL
